    sendemailalert2("Tomo scans are done. $0")
}'


# Center point
def MonoCryst1 '{
    local exptime _nframe _nlayer _sPrefix
	
    Sopen
    
    #note switch_to_FFDet4 moves aeroXE
    #switch_to_FFDet4
    
    # Measurement Position (Check)
    umv samXE -0.694 samZE 1.11 rxe -0.4 rze 0.0
    umv samYE  14.42

    umv aeroXE 4.9138
    
    #should be same as switch_to_FFDet4
    #C_slits 0.130 0.130 0.175 0.160 -0.072 0.155 -0.121 0.140
    E_slits 0.1 0.1 0.2 0.2 -0.023 0.019 -0.029 0.047
   
    ge_linescan_hydra_raster 14.42 14.42+0.1 8.0 0.02 0 0 3 "$0" 0 0 0 0.001 1 6.963-0.05 0.1 -0.694 8.0 1 0
    

}'

# Whole raster
def MonoCryst2 '{
    local exptime _nframe _nlayer _sPrefix
	
    Sopen
    
    #note switch_to_FFDet4 moves aeroXE
    #switch_to_FFDet4
    
    # Measurement Position (Check)
    umv samXE -0.694 samZE 1.11 rxe -0.4 rze 0.0
    umv samYE  14.42

    umv aeroXE 4.9138
    
    #should be same as switch_to_FFDet4
