def TiMnFeNiCu1_8_map_RmTemp'{


    local _xstart _xN _dx _ystart _yN _dy _att1 _att3 _fileName _cmd

    ########## IN718 ###########
    
    _fileName="TiMnFeNiCu-1_8_AsCast"

    _xstart=0.93 # [mm]
    _xN=1 # step number in X
    _dx=0.5

    _ystart=1.75 # [mm]
    _yN=11 # step number in Y 
    _dy = 1

    _att1= 0 # attenuator 1
    _att3= 3 # attenuator 3

   # Usage: zzyu_feb25_xyN_hydra [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [Use_MTS_DigIO] [_attenwheel] [_foilwheel] [_attenC] [do_fs]
    #zzyu_feb25_xyN_hydra 5 0.1 _fileName _xstart _xN 0.1 _ystart _yN 0.025 1 0 0 _att1 0 _att3 0
    cmd=sprintf("zzyu_feb25_xyN_hydra 10 0.1 %s %.3f %d %.2f %.3f %d %.2f 1 0 0 %d 0 %d 1 -45 45 aero",_fileName, _xstart, _xN, _dx, _ystart, _yN, _dy, _att1, _att3)
    eval(cmd)

}'


def AO_Ref_RmTemp'{


    local _xstart _xN _dx _ystart _yN _dy _att1 _att3 _fileName _cmd

    ########## IN718 ###########
    
    _fileName="AO_Ref_100x50"

    _xstart=2.93 # [mm]
    _xN=3 # step number in X
    _dx=0.2

