}'

def HPDC1 '{

    local _xstart _Nx _xstep _ystart _Ny _ystep _exptime _fname
    
    switch_to_HxV_beam 0.1 0.2
    
    _exptime=0.2
    _fname="$0"
    _xstart=-3.45
    _ystart=7.1     # 9mm from edge.
    _Nx=27
    _Ny=30
    _xstep=0.1
    _ystep=0.1

    #Usage: mpe_dec24_xyN_varex [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [_foilwheel] [_attenwheel] [_attenC]
    #mpe_dec24_xyN_varex 5 _exptime _fname _xstart _Nx _xstep _ystart _Ny _ystep 1 0 0 0 0
    cmd=sprintf("mpe_dec24_xyN_varex 5 %.3f %s %.3f %d %.3f %.3f %d %.3f 1 0 0 0 0",_exptime, _fname, _xstart, _Nx, _xstep, _ystart, _Ny, _ystep)
    #p cmd
    eval(cmd)
    
    DataMoveVarex EXPID

}'

def HPDC_air_0p2s '{

    local _xstart _Nx _xstep _ystart _Ny _ystep _exptime _fname
    
    switch_to_HxV_beam 0.1 0.2
    
    _exptime=0.2
    _fname="$0"
    _xstart=-2.8
    _ystart=3.1     # 10mm from edge.
    _Nx=1
    _Ny=1
    _xstep=0.1
    _ystep=0.2

    #Usage: mpe_dec24_xyN_varex [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [_foilwheel] [_attenwheel] [_attenC]
    #mpe_dec24_xyN_varex 5 _exptime _fname _xstart _Nx _xstep _ystart _Ny _ystep 1 0 0 0 0
    cmd=sprintf("mpe_dec24_xyN_varex 50 %.3f %s %.3f %d %.3f %.3f %d %.3f 1 0 0 0 0",_exptime, _fname, _xstart, _Nx, _xstep, _ystart, _Ny, _ystep)
    #p cmd
    eval(cmd)
    
    DataMoveVarex EXPID

}'



def tomo_template '{
    sendemailalert2("Tomo scans starting. $0")
	local exptime _nframe _nlayer
	
	###
    #switch_to_NFTomoDet
    switch_to_TomoDet
    switch_to_TomoBeam # 2.1 x 1.0
    # switch_to_HxV_beam 0.3 0.07
    ###
    Sopen

     ### Measurement Position (Check)
    umv rxe 0.68 rze -0.45
    umv samXE 0.92 samZE 1.34
    umv samYE 1.98  ## sample center is 5.4

    umv aeroXE 0.0

    ### Exposure time
    exptime=0.4;  ## 72 keV

    _nframe=1;
    _nlayer=1;    # layer thickness is 1mm.
    ShouldRotateBack=0
    
    unix(sprintf("mkdir -p /home/beams/S1IDUSER/mnt/s1c/%s/tomo/%s", EXPID, "$0"))
    # ccdset_filepath(sprintf("/home/beams/S1IDUSER/mnt/s1c/%s/tomo", EXPID)) # LINUX
    ccdset_filepath(sprintf("S:/%s/tomo", EXPID))  # WIN
    
	CheckLightsEhutch
	# TomoVolScan(bScanType, fOmegaBegin, fOmegaStop, fOmegaStep, fExposureTime, sPrefix, nframe, stagestep, nstage, nsamY, samYstep) 
	# DEFAULT_GAP_TIME = 0.3
    
    TomoVolScan(3, -180, 180, 0.1, exptime, "$0/$0", _nframe, 0.0, 1, _nlayer, 1.0)

    sendemailalert2("Tomo scans are done. $0")
}'



