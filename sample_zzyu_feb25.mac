# Example: ALERTLIST=ALERTCORELIST ""
# Put your e-mail addresses here with separation by a space like in the example above.
ALERTLIST=ALERTCORELIST " "

# google doc explog 
# doc log: https://docs.google.com/document/d/19j4n1C054ppc1ceUWvgtI8AsVydKgbYQwD1oSz9_dvY/edit?tab=t.0
# spread sheet: 


def sam6_maps_25C'{


    local _xstart _xN _ystart _yN _att1 _att3 _fileName _cmd

    ########## Alumina Map ###########
    
    _fileName="VB-APS-SSAO-6_25C_TestMap-AO"

    _xstart=1.28 # [mm]
    _xN=8 # step number in X

    _ystart=17.32 # [mm]
    _yN=44 # step number in Y

    _att1= 2 # attenuator 1
    _att3= 0 # attenuator 3

   # Usage: zzyu_feb25_xyN_hydra [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [Use_MTS_DigIO] [_attenwheel] [_foilwheel] [_attenC] [do_fs]
    #zzyu_feb25_xyN_hydra 5 0.1 _fileName _xstart _xN 0.1 _ystart _yN 0.025 1 0 0 _att1 0 _att3 0
    cmd=sprintf("zzyu_feb25_xyN_hydra 5 0.1 %s %.3f %d 0.1 %.3f %d 0.025 1 0 0 %d 0 %d 0",_fileName, _xstart, _xN, _ystart, _yN, _att1, _att3)
    eval(cmd)
    ########## SS304 Map ###########
    
    _fileName="VB-APS-SSAO-6_25C_TestMap-SS"

    _xstart=1.18
    _xN=10

    _ystart=18.42
    _yN=11

    _att1=0
    _att3=2

   # Usage: zzyu_feb25_xyN_hydra [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [Use_MTS_DigIO] [_attenwheel] [_foilwheel] [_attenC] [do_fs]
   #zzyu_feb25_xyN_hydra 5 0.1 _fileName _xstart _xN 0.1 _ystart _yN 0.025 1 0 0 _att1 0 _att3 0
    cmd=sprintf("zzyu_feb25_xyN_hydra 5 0.1 %s %.3f %d 0.1 %.3f %d 0.025 1 0 0 %d 0 %d 0",_fileName, _xstart, _xN, _ystart, _yN, _att1, _att3)
    eval(cmd)
}'


def sam6_maps_200C'{


    local _xstart _xN _dx _ystart _yN _dy _att1 _att3 _fileName _cmd

    ########## Alumina Map ###########
    
    _fileName="VB-APS-SSAO-6_200C_Map-AO"

    _xstart=1.43 # [mm]
    _xN=4 # step number in X
    _dx=0.2

    _ystart=17.37 # [mm]
    _yN=21 # step number in Y 
    _dy = 0.05

    _att1= 2 # attenuator 1
    _att3= 0 # attenuator 3

   # Usage: zzyu_feb25_xyN_hydra [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [Use_MTS_DigIO] [_attenwheel] [_foilwheel] [_attenC] [do_fs]
    #zzyu_feb25_xyN_hydra 5 0.1 _fileName _xstart _xN 0.1 _ystart _yN 0.025 1 0 0 _att1 0 _att3 0
    cmd=sprintf("zzyu_feb25_xyN_hydra 5 0.1 %s %.3f %d %.2f %.3f %d %.2f 1 0 0 %d 0 %d 0",_fileName, _xstart, _xN, _dx, _ystart, _yN, _dy, _att1, _att3)
    eval(cmd)
    
    ########## SS304 Map ###########
    
    _fileName="VB-APS-SSAO-6_200C_Map-SS"

    _xstart=1.43
    _xN=4
    #_dx=0.2

    _ystart=18.42
    _yN=7
    #_dy=0.05

    _att1=0
    _att3=2

   # Usage: zzyu_feb25_xyN_hydra [Nframe] [tframe] [fname] [x0] [Nx] [dx] [y0] [Ny] [dy] [nLoop] [tsleep] [Use_MTS_DigIO] [_attenwheel] [_foilwheel] [_attenC] [do_fs]
   #zzyu_feb25_xyN_hydra 5 0.1 _fileName _xstart _xN 0.1 _ystart _yN 0.025 1 0 0 _att1 0 _att3 0
   cmd=sprintf("zzyu_feb25_xyN_hydra 5 0.1 %s %.3f %d %.2f %.3f %d %.2f 1 0 0 %d 0 %d 0",_fileName, _xstart, _xN, _dx, _ystart, _yN, _dy, _att1, _att3)
   eval(cmd)
}'

