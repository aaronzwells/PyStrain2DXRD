    #switch_to_TomoBeam # 2.1 x 1.0
    # switch_to_HxV_beam 0.3 0.07
    ###
    #Sopen

     ### Measurement Position (w-pin position)
    #umv rxe 0.0 rze 0.0
    #umv samXE -1.26 samZE 0.016
    #umv samYE 9.4

    umv aeroXE 0.0

    ### Exposure time
    exptime=0.15;  ## 80 keV

    _nframe=1;
    _nlayer=1;    # layer thickness is 1mm.
    ShouldRotateBack=0
    
    unix(sprintf("mkdir -p /home/beams/S1IDUSER/mnt/s1c/%s/tomo/%s", EXPID, "$0"))
    ccdset_filepath(sprintf("/home/beams/S1IDUSER/mnt/s1c/%s/tomo", EXPID)) # LINUX
