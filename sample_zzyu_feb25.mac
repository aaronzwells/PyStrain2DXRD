def dummy1_ff '{ 
    sendemailalert2("FF scans are starting. $0")   
    local _ymid _ytop _ybot _ystp _nlay
    local _bot_tens _top_tens _ncycles
    
    move_cork_in
    
    remove_cmu_furnace

    #### FF 
    switch_to_FFDet
    # switch_to_Pilatus

    switch_to_HxV_beam 1.7 0.5
    # switch_to_FocusedBeam_200um
    # switch_to_HxV_beam 1.7 -_ystpokay
    # switch_to_HxV_beam 2.3 0.07

    Sopen
    
    ### REFERENCE POSITION
    umv rxe 0.000
    umv rze 0.000
    umv samXE 0.410 ## CHECK: center position 
    umv samZE 0.298 ##
    umv samYE 3.260 ## 
    umv aeroXE 0.0
    
    # umv rams3X 0.0
    # umv rams3Y 0.204

    ########################################################
    #### FF MOTION PARAMETERS
    ########################################################
    _ystp=0.2   ## may be negative steps  
    _ymid=A[samYE]   ## CHECK:  Yref
    # _ymid=A[rams3Y]   ## CHECK:  Yref
    _nlay=1        ## CHECK: number of layers # 54% of yield
    ###############################################
    ## Symmetric nlay (odd) layers around middle layer 
    # _ybot=_ymid - (_nlay-1)/2*_ystp; # _nlay layers
    # _ytop=_ybot + (_nlay-1)*_ystp + _ystp/2; # _nlay layers
    ###############################################
    ## Starting from top and going to botton nlay layers
    _ybot=_ymid # _nlay layers
    _ytop=_ybot + (_nlay-1)*_ystp + _ystp/2; # _nlay layers
    ###############################################

    p "_ybot=", _ybot, "_ytop=", _ytop
    
    Emon
    set_hydra_AutoStoreYes
    set_hydra_FileName "$0"

    #switch_to_FocusedBeam_1700um
    # switch_to_FocusedBeam_2100um
    # switch_to_HxV_beam 1.7 0.05
    # focusing_E_Vert_insert
        
    # REPEAT WITH 0.02 sec exposure time
    # 0.25 deg / 72 keV
    # ge_linescan_hydra _ybot _ytop _ystp 0.02 4 0 2 "$0" 0 0 0 0.25 1 -180.0 360.0 
    
    ## 0.25 deg / 52 keV / HRM
    # ge_linescan_hydra _ybot _ytop _ystp 0.02 3 0 0 "$0" 0 0 0 0.25 1 -180.0 360.0
    
    ## 0.25 deg / 72 keV / HEM
    ge_linescan_hydra _ybot _ytop _ystp 0.02 4 0 2 "$0" 0 0 0 0.25 1 -180.0 360.0  

    # 0.25 deg / 91 keV
    # "Usage: $0 [_ystart] [_yend] [_ystep] [_tint] [_attenwheel] [_foilwheel] [_attenC] [_fname] [_useMTSSIG] [_dicangle] [_dicheight] [qt] [_numloadsteps] [omestart] [omerange]"
    # ge_linescan_hydra _ybot _ytop _ystp 0.02 2 0 4 "$0" 0 0 0 0.25 1 -180.0 360.0

    ########################################################
    sendemailalert2("FF scans are done. $0")
}'

